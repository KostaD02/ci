{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "strict": true,
    "noImplicitAny": false
  },
  "include": [".github/actions/**/*.cjs", "test/**/*.cjs", "eslint.config.js"]
}
