{
  "name": "ci",
  "version": "1.0.0",
  "description": "Reusable GitHub Actions workflows for my repositories",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm run lint:actions && pnpm run lint:js",
    "lint:actions": "github-actionlint",
    "lint:js": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [],
  "author": "Konstantine Datunishvili <konstantineda@datunishvili.ge>",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "github-actionlint": "^1.7.12",
    "husky": "^9.1.7",
    "prettier": "^3.9.9"
  }
}
